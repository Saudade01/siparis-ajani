{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "SeedPath": "../../data/katalog/hirdavat-ornek.csv"
  },
  "Database": {
    "ConnectionString": "Data Source=App_Data/siparisajani.db"
  },
  "Anthropic": {
    "Enabled": false,
    "Model": "claude-opus-5",
    "MaxTokens": 16000,
    "UseServerSideFallback": true,
    "TimeoutSeconds": 60
  },
  "LogoExport": {
    "SheetName": "SIPARIS",
    "Columns": [
      { "Header": "STOK KODU", "Field": "Sku" },
      { "Header": "STOK ADI", "Field": "Name" },
      { "Header": "MIKTAR", "Field": "Quantity" },
      { "Header": "BIRIM", "Field": "Unit" },
      { "Header": "CARI KODU", "Field": "CustomerCode" },
      { "Header": "TARIH", "Field": "OrderDate" },
      { "Header": "ACIKLAMA", "Field": "Note" }
    ]
  }
}
